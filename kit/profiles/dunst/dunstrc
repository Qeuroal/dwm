[global]
    follow = keyboard
    origin = top-right
    offset = (16, 48)
    width = 340
    notification_limit = 4
    gap_size = 8
    corner_radius = 12
    frame_width = 1
    padding = 14
    horizontal_padding = 18
    text_icon_padding = 12

    font = Noto Sans SC 11
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 240
    progress_bar_max_width = 300
    progress_bar_corner_radius = 3

    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 32

[urgency_low]
    background = "#222b2e"
    foreground = "#c5cdd0"
    frame_color = "#3b474d"
    highlight = "#f46067"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "#222b2e"
    foreground = "#eeeeee"
    frame_color = "#3b474d"
    highlight = "#f46067"
    timeout = 6
    default_icon = dialog-information

[urgency_critical]
    background = "#302327"
    foreground = "#fff0f0"
    frame_color = "#f46067"
    highlight = "#f46067"
    timeout = 0
    default_icon = dialog-warning
