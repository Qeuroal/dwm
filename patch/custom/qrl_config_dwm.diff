+static void
+applyfloatsizerules(Client *c, int transient)
+{
+	XClassHint ch = { NULL, NULL };
+	const char *class, *instance;
+	unsigned int i;
+
+	if (!transient && !c->isfloating)
+		return;
+	XGetClassHint(dpy, c->win, &ch);
+	class = ch.res_class ? ch.res_class : broken;
+	instance = ch.res_name ? ch.res_name : broken;
+	for (i = 0; i < LENGTH(floatsizerules); i++) {
+		if (transient && !floatsizerules[i].transient)
+			continue;
+		if ((!floatsizerules[i].class || strstr(class, floatsizerules[i].class))
+		&& (!floatsizerules[i].instance || strstr(instance, floatsizerules[i].instance))
+		&& (!floatsizerules[i].title || strstr(c->name, floatsizerules[i].title))) {
+			if (floatsizerules[i].width_percent > 0 && floatsizerules[i].width_percent <= 100)
+				c->w = MAX(1, c->mon->ww * floatsizerules[i].width_percent / 100 - 2 * borderpx);
+			if (floatsizerules[i].height_percent > 0 && floatsizerules[i].height_percent <= 100)
+				c->h = MAX(1, c->mon->wh * floatsizerules[i].height_percent / 100 - 2 * borderpx);
+			break;
+		}
+	}
+	if (ch.res_class)
+		XFree(ch.res_class);
+	if (ch.res_name)
+		XFree(ch.res_name);
+}
